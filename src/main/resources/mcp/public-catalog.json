    "installs": [
      {
        "label": "npm (npx)",
        "transport": "STDIO",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-gitlab"],
        "env": [
          {
            "name": "GITLAB_PERSONAL_ACCESS_TOKEN",
            "description": "GitLab personal access token.",
            "secret": true,
            "required": true
          },
          {
            "name": "GITLAB_API_URL",
            "description": "Base API URL for self-hosted GitLab (defaults to gitlab.com).",
            "secret": false,
            "required": false
