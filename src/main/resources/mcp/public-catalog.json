[
  {
    "sourceId": "modelcontextprotocol/filesystem",
    "name": "Filesystem",
    "description": "Read, write, and search files within allowed directories on the host.",
    "repositoryUrl": "https://github.com/modelcontextprotocol/servers",
    "installs": [
      {
        "label": "npm (npx)",
        "transport": "STDIO",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed/dir"],
        "env": []
      }
    ]
  },
  {
    "sourceId": "modelcontextprotocol/github",
    "name": "GitHub",
    "description": "Manage repositories, issues, pull requests, and code search on GitHub.",
    "repositoryUrl": "https://github.com/modelcontextprotocol/servers",
    "installs": [
      {
        "label": "npm (npx)",
        "transport": "STDIO",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": [
          {
            "name": "GITHUB_PERSONAL_ACCESS_TOKEN",
            "description": "GitHub personal access token with the scopes your workflow needs.",
            "secret": true,
            "required": true
          }
        ]
      }
    ]
  },
  {
    "sourceId": "modelcontextprotocol/gitlab",
    "name": "GitLab",
    "description": "Interact with GitLab projects, issues, and merge requests.",
