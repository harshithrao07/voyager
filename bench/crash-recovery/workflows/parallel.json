{
  "StartAt": "MixedParallel",
  "States": {
    "MixedParallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "FastPause",
          "States": {
            "FastPause": {
              "Type": "Wait",
              "Seconds": 1,
              "Next": "FastBranchDone"
            },
            "FastBranchDone": {
              "Type": "Succeed"
            }
          }
        },
        {
          "StartAt": "SlowPause",
          "States": {
            "SlowPause": {
              "Type": "Wait",
              "Seconds": 120,
              "Next": "CountSlowBranch"
            },
            "CountSlowBranch": {
              "Type": "Task",
              "Resource": "voyager://system/webhook",
              "Arguments": {
                "url": "http://crash-counter:8080/invocations",
                "method": "POST",
                "includeExecutionContextHeaders": true,
                "body": {
                  "runId": "{% $states.input.runId %}",
                  "workload": "parallel-wait",
                  "operationId": "{% $states.context.StateExecutionId %}"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "SleepBranch",
          "States": {
            "SleepBranch": {
              "Type": "Task",
              "Resource": "__SLEEPER_RESOURCE__",
              "Arguments": {
                "runId": "{% $states.input.runId %}",
                "sleepSeconds": 3,
                "workload": "parallel-task"
              },
              "HeartbeatSeconds": 5,
              "TimeoutSeconds": 12,
              "Retry": [
                {
                  "ErrorEquals": ["States.Timeout", "Function.PlatformError"],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 2,
                  "BackoffRate": 1.0
                }
              ],
              "Next": "CountTaskBranch"
            },
            "CountTaskBranch": {
              "Type": "Task",
              "Resource": "voyager://system/webhook",
              "Arguments": {
                "url": "http://crash-counter:8080/invocations",
                "method": "POST",
                "includeExecutionContextHeaders": true,
                "body": {
                  "runId": "{% $states.input.runId %}",
                  "workload": "parallel-task",
                  "operationId": "{% $states.context.StateExecutionId %}"
                }
              },
              "End": true
            }
          }
        }
      ],
      "End": true
    }
  }
}
